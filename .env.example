# Спільні налаштування
# Режим виконання, який використовують усі сервіси.
NODE_ENV=development

# API
# Публічний порт API, який Docker Compose відкриває на host.
API_PORT=3000
# Локальний JWT signing secret. Замінити для розгортань поза demo mode.
JWT_SECRET=change-me-in-local-env
# Час життя сесії у секундах.
JWT_EXPIRES_IN_SECONDS=604800

# Frontend
# Публічний Vite/web порт, який Docker Compose відкриває на host.
WEB_PORT=5173
# API URL, який використовує browser client.
VITE_API_BASE_URL=http://localhost:3000/api
# Показує посилання на queue monitoring у web UI для режиму reviewer/admin.
VITE_SHOW_QUEUE_LINK=true

# База даних
# Назва PostgreSQL database, яку створює Compose.
POSTGRES_DB=news_hub
# PostgreSQL user, якого створює Compose.
POSTGRES_USER=news_hub
# PostgreSQL password, який створює Compose.
POSTGRES_PASSWORD=news_hub_password
# Internal Docker database URL для API та worker services.
DATABASE_URL=postgresql://news_hub:news_hub_password@postgres:5432/news_hub

# Redis / queues
# Internal Docker Redis URL для BullMQ.
REDIS_URL=redis://redis:6379
# Вмикає route для Bull Board.
BULL_BOARD_ENABLED=true
# Bull Board basic-auth user.
BULL_BOARD_USER=admin
# Bull Board basic-auth password.
BULL_BOARD_PASSWORD=change-me

# LLM
# Стандартний mock provider безпечний для перевірки і не потребує external keys.
# Ставити LLM_PROVIDER=openai або LLM_PROVIDER=anthropic тільки коли є real API keys.
# LLM provider, який використовують workers.
LLM_PROVIDER=mock
# Стандартна model name для providers, які використовують спільне model setting.
LLM_MODEL=gpt-4o-mini
# Вмикає provider fallback за списком LLM_FALLBACK_PROVIDERS.
LLM_FAILOVER_ENABLED=false
# Впорядкований список fallback providers, коли failover увімкнений.
LLM_FALLBACK_PROVIDERS=anthropic,openai
# Максимальна кількість response tokens для real providers.
LLM_MAX_TOKENS=1800
# Глобальний LLM worker concurrency cap.
LLM_CONCURRENCY=2
# Request timeout для real provider calls.
LLM_REQUEST_TIMEOUT_MS=60000
# Prompt-token price для telemetry cost estimates.
LLM_PROMPT_COST_USD_PER_1M_TOKENS=0.15
# Completion-token price для telemetry cost estimates.
LLM_COMPLETION_COST_USD_PER_1M_TOKENS=0.60
# OpenAI model override.
OPENAI_MODEL=gpt-4o-mini
# OpenAI API base URL.
OPENAI_BASE_URL=https://api.openai.com/v1
# OpenAI API key. У local mock mode лишити порожнім.
OPENAI_API_KEY=
# Anthropic API key. У local mock mode лишити порожнім.
ANTHROPIC_API_KEY=
# Anthropic model override.
ANTHROPIC_MODEL=claude-sonnet-4-5
# Anthropic API base URL.
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Anthropic API version header.
ANTHROPIC_VERSION=2023-06-01

# Demo seed
# Demo account email, який створюється під час startup.
DEMO_USER_EMAIL=demo@example.com

# Feed polling
# Cron schedule для repeated feed polling.
FEED_POLL_CRON=*/30 * * * *
# Feed polling worker concurrency.
FEED_POLL_CONCURRENCY=3
# HTTP timeout для RSS/Atom fetches.
FEED_FETCH_TIMEOUT_MS=15000
# Short preflight timeout, який використовується під час додавання нового feed.
FEED_CREATE_VALIDATE_TIMEOUT_MS=5000
# Максимальна кількість items з одного feed за один polling run.
FEED_MAX_ITEMS_PER_RUN=50

# Pre-filter
# Мінімальна довжина extracted text, після якої article може потрапити до LLM.
ARTICLE_MIN_TEXT_CHARS=500
# Максимальна довжина text, який надсилається до LLM.
ARTICLE_MAX_TEXT_CHARS=50000
# SEO phrase threshold, який використовує pre-filter.
ARTICLE_SEO_PHRASE_THRESHOLD=2
# Article-processing worker concurrency.
ARTICLE_PROCESSING_CONCURRENCY=3
# Axis regeneration worker concurrency.
AXIS_REGENERATION_CONCURRENCY=1
# Digest generation worker concurrency.
DIGEST_GENERATION_CONCURRENCY=1
