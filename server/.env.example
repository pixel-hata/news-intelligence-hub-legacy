# Скопіюйте цей файл як .env і заповніть. .env НЕ додавайте в git.

PORT=8080

# --- Telegram ---
# 1) У Telegram напишіть @BotFather → /newbot → отримаєте токен.
# 2) Створіть спільний канал або групу, додайте туди бота адміністратором.
# 3) ID каналу: перешліть будь-яке повідомлення з каналу боту @userinfobot
#    (або для публічного каналу можна писати @назва_каналу).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Пошта (SMTP) ---
# Наприклад, Gmail: smtp.gmail.com, порт 465, пароль — «пароль застосунку» з налаштувань Google.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Куди надсилати заявки (можна кілька через кому)
MAIL_TO=
